# sso-local — environment configuration
#
# Copy this file to `.env` (git-ignored) and adjust the values.
# `./run.sh` loads `.env` automatically; variables already exported in your
# shell take precedence over the values in this file.

# Public port — ONE port for everything (UI + API + OIDC).
# This is what you open in the browser: http://localhost:${PORT}/#projects
PORT=8080

# Internal loopback port for the Go IdP. It is never exposed to the browser;
# the Vite dev server proxies /api/* and /{tenant}/* to it.
# Leave commented to auto-pick the first free port in 8081-8100.
# GO_PORT=8081

# Proxy target used by the Vite dev server.
# Defaults to http://localhost:${GO_PORT} — only override if the Go server is
# already running somewhere else (external/remote instance).
# SSO_BACKEND=http://localhost:8081

# Default tenant alias or GUID passed to `sso-local -tenant`
# (common | organizations | consumers | <tenant-guid>)
TENANT=common
